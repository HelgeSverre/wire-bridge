{
    "name": "wire-bridge",
    "version": "0.1.2",
    "description": "Framework-independent bridge that shares one mounted Livewire component's state with any frontend renderer. Preact, React, Solid, Svelte and Vue adapters included.",
    "type": "module",
    "license": "MIT",
    "author": "Helge Sverre <helge.sverre@gmail.com>",
    "homepage": "https://github.com/HelgeSverre/wire-bridge#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HelgeSverre/wire-bridge.git"
    },
    "bugs": {
        "url": "https://github.com/HelgeSverre/wire-bridge/issues"
    },
    "sideEffects": false,
    "files": [
        "src",
        "dist/types",
        "docs/*.md",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "default": "./src/index.js"
        },
        "./json": {
            "types": "./dist/types/json.d.ts",
            "default": "./src/json.js"
        },
        "./livewire": {
            "types": "./dist/types/livewire.d.ts",
            "default": "./src/livewire.js"
        },
        "./preact": {
            "types": "./dist/types/preact.d.ts",
            "default": "./src/preact.js"
        },
        "./react": {
            "types": "./dist/types/react.d.ts",
            "default": "./src/react.js"
        },
        "./solid": {
            "types": "./dist/types/solid.d.ts",
            "default": "./src/solid.js"
        },
        "./svelte": {
            "types": "./dist/types/svelte.d.ts",
            "default": "./src/svelte.js"
        },
        "./vue": {
            "types": "./dist/types/vue.d.ts",
            "default": "./src/vue.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "types": "tsc -p tsconfig.json",
        "build": "npm run types",
        "check": "npm run typecheck && npm test",
        "publint": "publint",
        "attw": "attw --pack . --profile esm-only"
    },
    "peerDependencies": {
        "preact": ">=10",
        "react": ">=18",
        "solid-js": ">=1.7",
        "vue": ">=3.3"
    },
    "peerDependenciesMeta": {
        "preact": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "solid-js": {
            "optional": true
        },
        "vue": {
            "optional": true
        }
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.2",
        "@types/react": "^19.2.2",
        "preact": "^10.29.8",
        "publint": "^0.3.12",
        "react": "^19.2.0",
        "solid-js": "^1.9.15",
        "typescript": "^5.9.2",
        "vitest": "^5.0.1",
        "vue": "^3.5.22"
    },
    "keywords": [
        "livewire",
        "laravel",
        "preact",
        "react",
        "solid",
        "svelte",
        "vue",
        "bridge",
        "state",
        "islands"
    ],
    "engines": {
        "node": ">=18"
    }
}
